# ==================================================
# CUDA BASE IMAGE (runtime + dev tools available)
# ==================================================
FROM nvidia/cuda:12.1.0-devel-ubuntu22.04

# ---------------------------
# Environment
# ---------------------------
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV LANG=C.UTF-8

# IMPORTANT: DO NOT FORCE CMAKE OR CUDA BUILD
# We rely on prebuilt wheels instead

# CUDA runtime visibility
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/cuda/compat/lib.real:$LD_LIBRARY_PATH

# ---------------------------
# System dependencies
# ---------------------------
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    build-essential \
    git \
    curl \
    wget \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------
# Upgrade pip tooling
# ---------------------------
RUN pip3 install --upgrade pip setuptools wheel

# ---------------------------
# Work directory
# ---------------------------
WORKDIR /app

# ---------------------------
# Python dependencies (NO llama-cpp here)
# ---------------------------
COPY requirements.txt .

RUN pip3 install --no-cache-dir -r requirements.txt

# ==================================================
# CUDA llama-cpp-python (PREBUILT WHEEL ONLY)
# ==================================================
RUN pip install --no-cache-dir \
    "llama-cpp-python[server]" \
    --extra-index-url https://abetlen.github.io/llama-cpp-python/whl/cu121

# ---------------------------
# Copy application
# ---------------------------
COPY . .

# ---------------------------
# Expose API port
# ---------------------------
EXPOSE 8000

# ---------------------------
# Run FastAPI
# ---------------------------
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
